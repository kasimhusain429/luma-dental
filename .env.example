# Public canonical URL (used for metadata, sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example-dental.com

# Optional clinic details (shown in footer + JSON-LD when set)
NEXT_PUBLIC_CLINIC_PHONE=
NEXT_PUBLIC_CLINIC_EMAIL=
NEXT_PUBLIC_CLINIC_STREET=
NEXT_PUBLIC_CLINIC_CITY=
NEXT_PUBLIC_CLINIC_REGION=
NEXT_PUBLIC_CLINIC_POSTCODE=
NEXT_PUBLIC_CLINIC_COUNTRY=

# REQUIRED in production: booking requests are POSTed here as JSON.
# Works with Zapier / Make / n8n / Slack-incoming-webhook-style endpoints, or your own service.
BOOKING_WEBHOOK_URL=
